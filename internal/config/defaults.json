{
  "actor": "",
  "concurrency": {
    "require_expect": "warn",
    "auto_save": "clean",
    "auto_load_on_drift": true
  },
  "transactions": {
    "auto_rollback_idle_for": "10m"
  },
  "stale": {
    "buffer_idle_for": "14d",
    "branch_idle_for": "7d"
  },
  "auto_prune": {
    "enabled": true,
    "on_close": true,
    "on_open": false,
    "schedule": "daily",
    "policies": {
      "closed_files_older_than": "30d",
      "dead_branches_idle_for": "7d",
      "keep_recent_per_branch": 200
    }
  },
  "audit": {
    "retention": "90d",
    "auto_prune": true
  },
  "output": {
    "default_format": "tab",
    "include_state_token": true,
    "syntax_highlight": true,
    "nudge_on_pipe": true,
    "edit_diff": "tty"
  },
  "skill": {
    "enforce_version": "major"
  },
  "mcp": {
    "default_transport": "stdio",
    "tcp_port": 0,
    "unix_socket_path": ""
  },
  "logging": {
    "level": "info",
    "destination": "stderr"
  },
  "ide": {
    "enabled": false,
    "auto_start_daemon": true,
    "languages": {
      "go": {
        "auto_start": true,
        "servers": [
          { "name": "gopls", "command": "gopls" }
        ]
      },
      "typescript": {
        "auto_start": false,
        "servers": [
          { "name": "tsserver", "command": "typescript-language-server", "args": ["--stdio"] },
          { "name": "eslint",   "command": "vscode-eslint-language-server", "args": ["--stdio"] }
        ]
      },
      "python": {
        "auto_start": false,
        "servers": [
          { "name": "pyright", "command": "pyright-langserver", "args": ["--stdio"] },
          { "name": "ruff",    "command": "ruff", "args": ["server"] }
        ]
      },
      "rust": {
        "auto_start": false,
        "servers": [
          { "name": "rust-analyzer", "command": "rust-analyzer" }
        ]
      }
    },
    "extensions": {
      ".go":  "go",
      ".ts":  "typescript",
      ".tsx": "typescript",
      ".rs":  "rust",
      ".py":  "python"
    },
    "diagnostics": {
      "default": "warnings",
      "max_per_response": 50,
      "cache_ttl": "5m"
    }
  }
}
